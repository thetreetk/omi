# ~/.config/omi-frontdoor/env  (chmod 600). Optional.
# Tier 2: Anthropic API key. Leave unset to skip the API tier.
# ANTHROPIC_API_KEY=
# Hourly cap on subscription calls from the front door (protects your plan from background work)
# FD_SUB_MAX_PER_HOUR=40
# FD_LOCAL_MODEL=qwen3-vl:30b-a3b-instruct
# FD_EMBED_MODEL=nomic-embed-text
